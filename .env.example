# --- App ---
APP_NAME=forge-tasks
APP_ENV=development
DEBUG=true

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy URL (async-драйвер asyncpg)
# Локально: localhost. В Docker compose подставляет postgres автоматически.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# --- RabbitMQ / Celery ---
# Локально: localhost. В Docker compose подставляет rabbitmq автоматически.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# --- Timezone ---
TIMEZONE=Europe/Moscow